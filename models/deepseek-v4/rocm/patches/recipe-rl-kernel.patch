+def recipe_workload(root):
+    from omegaconf import OmegaConf
+    config = OmegaConf.load(Path(root).parent / "hydra/.hydra/config.yaml")
+    steps = int(config.trainer.total_training_steps)
+    responses = int(config.data.train_batch_size) * int(config.actor_rollout_ref.rollout.n)
+    if steps not in (3, 200) or responses not in (4, 16, 128):
+        raise ValueError("unrecognized recipe step/response workload")
+    assert config.actor_rollout_ref.actor.ppo_epochs == 1
+    assert config.actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu == 1
+    assert config.actor_rollout_ref.actor.ppo_mini_batch_size == config.data.train_batch_size
+    assert int(config.rlk.get("stress_final_repeats", 0)) == 0
+    return config, steps, responses
+
